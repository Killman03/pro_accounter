# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here
# Proxy for Telegram API (optional):
# Main format:
# TG_PROXY=ip:8000:username:login
# Also supported:
# TG_PROXY=127.0.0.1:8080
# TG_PROXY_URL=http://username:password@127.0.0.1:8080
TG_PROXY=
TG_PROXY_URL=

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=coffee_rent
