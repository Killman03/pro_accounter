# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here
DEV_LOG_TELEGRAM_ID=
# Telegram proxy for aiogram (required only if Telegram is blocked from server IP):
# Format:
# TELEGRAM_PROXY_URL=socks5://username:password@ip:port
TELEGRAM_PROXY_URL=
STARTUP_MAX_TELEGRAM_LATENCY_MS=2000

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=coffee_rent

# Meta Conversions API (optional)
META_CAPI_ACCESS_TOKEN=
META_CAPI_DATASET_ID=
META_CAPI_API_VERSION=v25.0
META_CAPI_LEAD_EVENT_SOURCE=Telegram Bot CRM
# For test events in Events Manager:
META_CAPI_TEST_EVENT_CODE=
# Optional proxy for Meta CAPI requests (http/https/socks5)
META_CAPI_PROXY_URL=
