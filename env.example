# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here
# Telegram proxy for aiogram (required only if Telegram is blocked from server IP):
# Format:
# TELEGRAM_PROXY_URL=socks5://username:password@ip:port
TELEGRAM_PROXY_URL=
STARTUP_MAX_TELEGRAM_LATENCY_MS=2000

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=coffee_rent
